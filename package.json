{
  "name": "venueflow-app",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^5.0.5": "5.0.9",
    "js-yaml": "4.3.1",
    "postcss": "8.5.25",
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api:dev": "npm run start:dev -w @venue-wrangler/api",
    "api:build": "npm run build -w @venue-wrangler/api",
    "api:prisma:generate": "npm run prisma:generate -w @venue-wrangler/api",
    "api:migrate:dev": "npm run prisma:migrate:dev -w @venue-wrangler/api",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.12",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.13",
    "fast-uri": "^4.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.12.0",
    "react-native-purchases": "^10.1.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "undici": "^8.9.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "^4.1.9",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
