# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
web-dist/
expo-env.d.ts
packages/*/dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# ...but the EAS Update code-signing certificate (public key) is meant to be
# committed — only the private key stays out (see keys/ below).
!certs/certificate.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated auth keys (contain a private key — never commit)
scripts/.auth-keys.json

# EAS Update code-signing keys (private key must never be committed).
# The certificate in certs/ IS meant to be committed. Back up
# keys/private-key.pem somewhere safe (KMS/password manager) — publishes
# require it: `eas update --private-key-path keys/private-key.pem`.
keys/

# Local tooling artifacts (Claude Code, Codex, agent runners)
.claude/
.codex/
.agents/
.vs/
.expo-web-check/
.superdesign/

# Supabase CLI link metadata
supabase/.temp/

# Build artifacts and assets
builds/
facebook-assets/
screenshots/

