# Supabase Postgres connection used by the running API and Prisma migrations.
# Prefer the pooler URL for Cloud Run; keep the direct URL for migrations when
# the deployment environment supports IPv6/direct database access.
DATABASE_URL="postgresql://postgres.<project-ref>:password@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_DIRECT_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# Safety latch: release/start commands refuse a different Supabase project.
EXPECTED_SUPABASE_PROJECT_REF="<project-ref>"
# Per-instance Prisma connections. With Supabase's 60-connection limit, use
# five by default and size Cloud Run's max instances against that budget.
DATABASE_POOL_SIZE="5"

JWT_SECRET="replace-me-with-a-long-random-secret"
API_PUBLIC_URL="https://api.example.com"
# Store this and each provider client secret in Secret Manager for production.
SSO_STATE_SECRET="replace-me-with-at-least-32-random-characters"
# Example OIDC provider secret reference configured in Enterprise SSO admin:
SSO_AZURE_AD_CLIENT_SECRET="replace-me-with-secret-manager-value"
# Optional dedicated secret for chat/document media HMAC tokens.
# Falls back to JWT_SECRET when unset. Prefer setting this so media
# tokens can rotate independently of session JWTs.
MEDIA_TOKEN_SECRET=""
REVENUECAT_WEBHOOK_SECRET="replace-me-with-a-long-random-token"
REVENUECAT_API_KEY="replace-me-with-revenuecat-secret-api-key"
# Stripe webhook signing secret (Dashboard > Developers > Webhooks). Required
# for POST /api/v1/billing/stripe/webhook; the endpoint fails closed without it.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe secret API key. Required for web checkout + customer portal
# (POST /api/v1/app/billing/stripe/checkout and /portal).
STRIPE_SECRET_KEY="sk_live_..."
# Optional: an existing recurring Price id for the $99.99/mo plan. If unset, the
# API reuses-or-creates one keyed by lookup_key "venue_wrangler_monthly".
STRIPE_PRICE_ID=""
# Public web origin for Stripe success/cancel/return URLs.
APP_WEB_URL="https://venuewrangler.com"
API_PORT=4000
# Halftime write-behind pipeline. Keep disabled until RabbitMQ and Memorystore
# are reachable from Cloud Run; API requests fail closed when enabled but absent.
HIGH_VOLUME_QUEUE_ENABLED=false
REDIS_URL=redis://:password@10.0.0.3:6379/0
RABBITMQ_URL=amqps://stadium:password@rabbitmq.internal:5671/%2f
QUEUE_PREFETCH=50
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Transactional email delivery through Resend.
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Venue Wrangler <no-reply@venuewrangler.com>"

# Optional — these features fail closed with a clear error when unset;
# everything else works without it.
# Gemini is the sole AI provider for schedules, staff imports, and inventory.
# Create an API key in Google AI Studio and set it in Cloud Run.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_SCHEDULER_MODEL=""
GEMINI_STAFF_IMPORT_MODEL=""
GEMINI_INVENTORY_MODEL=""
# AI spend guardrails. A request reservation is held briefly before each
# provider call so concurrent API instances cannot overspend a venue budget.
AI_MONTHLY_VENUE_BUDGET_USD="10"
AI_MONTHLY_VENUE_WARNING_PERCENT="80"
# This is enforced on every Gemini request and reserved alongside its exact
# countTokens input total before generation starts.
AI_MAX_OUTPUT_TOKENS="2048"
AI_BUDGET_RESERVATION_TTL_SECONDS="120"
AI_COST_INPUT_PER_MILLION_USD=""
AI_COST_OUTPUT_PER_MILLION_USD=""

# AWS S3 — required for chat image uploads. S3ImageService calls getOrThrow on
# these at boot, so the API will not start without them. Bucket should be
# private; images are served via presigned URLs.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="venuewrangler-chat-images"

# Max JSON request body size. Must exceed the base64-encoded document size
# (~13.4MB for a 10MB file). Defaults to 16mb if unset.
JSON_BODY_LIMIT="16mb"
