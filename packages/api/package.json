{
  "name": "@venue-wrangler/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node scripts/assert-database-target.mjs && node dist/main.js",
    "start:dev": "node scripts/assert-database-target.mjs && nest start --watch",
    "start:prod": "node scripts/assert-database-target.mjs && node dist/main.js",
    "release": "node scripts/assert-database-target.mjs && prisma migrate deploy",
    "test": "vitest run",
    "test:integration": "vitest run --config ../../vitest.integration.config.ts",
    "lint": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "node scripts/assert-database-target.mjs && prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/assert-database-target.mjs && prisma migrate deploy",
    "prisma:migrate:status": "node scripts/assert-database-target.mjs && prisma migrate status",
    "prisma:studio": "node scripts/assert-database-target.mjs && prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.62.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.4.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.3",
    "typescript": "~7.0.2"
  }
}
