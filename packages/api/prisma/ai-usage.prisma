// Server-owned AI metering table created by 20260808134500_ai_usage_metering.
// The venue/profile foreign keys were created by that SQL migration; they are
// declared as real relations here (multi-file schema support makes cross-file
// relations a one-liner per side) so `prisma migrate dev` no longer proposes
// dropping those FKs as drift.
model AiUsageEvent {
  id                  String   @id
  venueId             String
  profileId           String?
  feature             String
  provider            String
  model               String
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  cachedTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  estimatedCostMicros Int      @default(0)
  createdAt           DateTime @default(now())
  venue               Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile             Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@index([venueId, feature, createdAt])
  @@index([profileId, createdAt])
}

// A short-lived, pessimistic cost reservation created before an AI provider
// request. It serializes the monthly spend check across Cloud Run instances
// without holding a database transaction open for the provider round trip.
model AiBudgetReservation {
  id                 String   @id
  venueId            String
  reservedCostMicros Int
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, expiresAt])
}
