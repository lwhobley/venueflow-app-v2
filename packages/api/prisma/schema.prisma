  other
}

enum EventFnbReadinessStatus {
  not_started
  in_progress
  ready
  blocked
}

enum FnbPartnerType {
  local_concept
  restaurant_concept
  pop_up
  licensed_brand
  food_vendor
  beverage_vendor
  distributor
  other
}

enum FnbPartnerStatus {
  onboarding
  approved
  active
  paused
  noncompliant
  terminated
}

enum MembershipStatus {
  pending
  active
  rejected
  revoked
}

enum WorkplaceJoinRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model User {
  id                        String                      @id @default(cuid())
  email                     String?                     @unique
  phone                     String?                     @unique
  emailVerifiedAt           DateTime?
  emailVerificationCodeHash String?
  emailVerificationSentAt   DateTime?
  termsAcceptedAt           DateTime?
  passwordResetCodeHash     String?
  passwordResetExpiresAt    DateTime?
  passwordResetSentAt       DateTime?
  failedSignInCount         Int                         @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime                    @default(now())
  // One profile per venue — a user with multi-venue access has multiple rows.
  profiles                  Profile[]
  sessions                  Session[]
  accounts                  AuthAccount[]
  password                  PasswordCredential?
  joinRequests              WorkplaceJoinRequest[]      @relation("WorkplaceJoinRequestUser")
  decidedJoinRequests       WorkplaceJoinRequest[]      @relation("WorkplaceJoinRequestDecider")
  joinRequestEvents         WorkplaceJoinRequestEvent[]
  organizationMemberships   OrganizationMembership[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String?  @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  salt         String
  iterations   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id               String                   @id @default(cuid())
  name             String
  code             String                   @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  venues           Venue[]
  eventIssues      EventIssue[]
  eventAuditLogs   EventAuditLog[]
  facilities       Facility[]
  facilityZones    FacilityZone[]
  subVenues        SubVenue[]
  outlets          Outlet[]
  terminals        Terminal[]
  memberships      OrganizationMembership[]
  scopeAssignments ScopeAssignment[]
}

model Facility {
  id               String            @id @default(cuid())
  organizationId   String
  code             String
  name             String
  timezone         String?
  address          String?
  latitude         Float?
  longitude        Float?
  capacity         Int?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  zones            FacilityZone[]
  subVenues        SubVenue[]
  outlets          Outlet[]
  terminals        Terminal[]
  scopeAssignments ScopeAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model FacilityZone {
  id               String            @id @default(cuid())
  organizationId   String
  facilityId       String
  code             String
  name             String
  zoneType         FacilityZoneType  @default(concourse)
  level            String?
  sortOrder        Int               @default(0)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility         Facility          @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Cascade)
  subVenues        SubVenue[]
  outlets          Outlet[]
  terminals        Terminal[]
  scopeAssignments ScopeAssignment[]

  @@unique([organizationId, facilityId, id])
  @@unique([organizationId, facilityId, code])
  @@index([organizationId, facilityId, active, sortOrder])
}

model SubVenue {
  id             String       @id @default(cuid())
  organizationId String
  facilityId     String
  zoneId         String
  code           String
  name           String
  subVenueType   SubVenueType
  capacity       Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Cascade)
  zone           FacilityZone @relation(fields: [organizationId, facilityId, zoneId], references: [organizationId, facilityId, id], onDelete: Cascade)
  outlets        Outlet[]

  @@unique([organizationId, facilityId, zoneId, id])
  @@unique([organizationId, facilityId, code])
  @@index([organizationId, facilityId, zoneId, active])
}

model Outlet {
  id             String           @id @default(cuid())
  organizationId String
  facilityId     String
  zoneId         String
  subVenueId     String?
  code           String
  name           String
  department     FnbDepartment
  outletType     FnbOperationType
  status         FnbUnitStatus    @default(open)
  capacity       Int?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility       Facility         @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Cascade)
  zone           FacilityZone     @relation(fields: [organizationId, facilityId, zoneId], references: [organizationId, facilityId, id], onDelete: Restrict)
  subVenue       SubVenue?        @relation(fields: [organizationId, facilityId, zoneId, subVenueId], references: [organizationId, facilityId, zoneId, id], onDelete: Restrict)
  terminals      Terminal[]

  @@unique([organizationId, facilityId, zoneId, id])
  @@unique([organizationId, facilityId, code])
  @@index([organizationId, facilityId, zoneId, status])
  @@index([subVenueId])
}

model Terminal {
  id             String       @id @default(cuid())
  organizationId String
  facilityId     String
  zoneId         String
  outletId       String
  code           String
  name           String
  terminalType   TerminalType @default(pos)
  externalRef    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facility       Facility     @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Cascade)
  zone           FacilityZone @relation(fields: [organizationId, facilityId, zoneId], references: [organizationId, facilityId, id], onDelete: Restrict)
  outlet         Outlet       @relation(fields: [organizationId, facilityId, zoneId, outletId], references: [organizationId, facilityId, zoneId, id], onDelete: Cascade)

  @@unique([organizationId, facilityId, outletId, code])
  @@index([organizationId, facilityId, zoneId, active])
  @@index([outletId])
}

model OrganizationMembership {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         MembershipStatus  @default(active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes         ScopeAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId, status])
}

model ScopeAssignment {
  id             String                 @id @default(cuid())
  organizationId String
  membershipId   String
  facilityId     String?
  zoneId         String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  facility       Facility?              @relation(fields: [organizationId, facilityId], references: [organizationId, id], onDelete: Cascade)
  zone           FacilityZone?          @relation(fields: [organizationId, facilityId, zoneId], references: [organizationId, facilityId, id], onDelete: Cascade)

  // SQL migration adds CHECK (zoneId IS NULL OR facilityId IS NOT NULL) and
  // partial unique indexes because PostgreSQL treats NULLs as distinct.
  @@index([membershipId])
  @@index([organizationId, facilityId, zoneId, active])
}

model Venue {
  id                            String                    @id @default(cuid())
  organizationId                String
  name                          String
  latitude                      Float
  longitude                     Float
  geofenceRadiusM               Float
  // IANA timezone (e.g. "America/New_York"). Null falls back to UTC; used to
  // bucket daily reports in the venue's business day rather than server time.
  timezone                      String?
  code                          String                    @unique
  phone                         String?
  address                       String?
  venueType                     String?
  stadiumCapacity               Int?
  homeTeam                      String?
  staffRange                    String?
  weeklyLaborBudgetHours        Float?
  schedulePublishedAt           DateTime?
  schedulePublishedById         String?
  scheduleUpdatedAfterPublishAt DateTime?
  // Availability lock window. Staff set availability for upcoming pay periods;
  // a period locks once it begins, unless availabilityUnlocked is set venue-wide.
  payPeriodAnchor               String?
  payPeriodLengthDays           Int                       @default(14)
  availabilityUnlocked          Boolean                   @default(false)
  earlyClockInWindowMin         Int                       @default(10)
  subscriptionStatus            SubscriptionStatus?
  subscriptionPlatform          SubscriptionPlatform?
  leadsWebhookSecret            String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  profiles                      Profile[]
  shifts                        ScheduleShift[]
  shiftSwaps                    ShiftSwap[]
  availability                  Availability[]
  conversations                 Conversation[]
  messages                      Message[]
  conversationReads             ConversationRead[]
  chatImages                    ChatImage[]
  notifications                 NotificationEvent[]
  pushTokens                    PushToken[]
  timeEntries                   TimeEntry[]
  blackoutDates                 BlackoutDate[]
  staffRequests                 StaffRequest[]
  guests                        Guest[]
  reservations                  Reservation[]
  floorPlans                    FloorPlan[]
  tables                        TableState[]
  subscriptions                 Subscription[]
  subscriptionEvents            SubscriptionEvent[]
  crmLeads                      CrmLead[]
  posChecks                     PosCheck[]
  scheduleTemplates             ScheduleTemplate[]
  notificationReads             NotificationRead[]
  waitlistEntries               Waitlist[]
  tableAssignments              TableAssignment[]
  posConnections                PosConnection[]
  posLaborPunches               PosLaborPunch[]
  crmActivityLogs               CrmActivityLog[]
  crmBeos                       CrmBeo[]
  crmContracts                  CrmContract[]
  emailTemplates                EmailTemplate[]
  reservationHolds              ReservationHold[]
  paymentMethods                PaymentMethod[]
  invoices                      Invoice[]
  venueRoles                    VenueRole[]
  teams                         Team[]
  scheduleEmailEvents           ScheduleEmailEvent[]
  payrollExports                PayrollExport[]
  reservationConnections        ReservationConnection[]
  reservationSyncEvents         ReservationSyncEvent[]
  barInventoryItems             BarInventoryItem[]
  barInventoryMovements         BarInventoryMovement[]
  prepBoardItems                PrepBoardItem[]
  staffOnboardingTasks          StaffOnboardingTask[]
  logbookEntries                LogbookEntry[]
  checklistTemplateItems        ChecklistTemplateItem[]
  checklistCompletions          ChecklistCompletion[]
  auditLogs                     AuditLog[]
  managerGoals                  ManagerGoal[]
  venueEvents                   VenueEvent[]
  scheduleMemoryNotes           ScheduleMemoryNote[]
  reservationSetting            ReservationSetting?
  tableStateHistory             TableStateHistory[]
  invites                       Invite[]
  aiUsageEvents                 AiUsageEvent[]
  aiBudgetReservations          AiBudgetReservation[]
  joinRequests                  WorkplaceJoinRequest[]
  eventExecutionWorkspaces      EventExecutionWorkspace[]
  documents                     VenueDocument[]
  fnbOperationUnits             FnbOperationUnit[]
  eventFnbReadiness             EventFnbReadiness[]
  fnbPartners                   FnbPartner[]
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventIssues                   EventIssue[]
  eventAuditLogs                EventAuditLog[]

  @@index([organizationId])
}

model Profile {
  id                         String               @id @default(cuid())
  userId                     String?
  tokenIdentifier            String?
  email                      String
  fullName                   String
  role                       Role
  jobTitle                   String
  phone                      String?
  altPhone                   String?
  address                    String?
  dateOfBirth                DateTime?
  certifications             String[]             @default([])
  venueId                    String?
  membershipStatus           MembershipStatus?
  allAccess                  Boolean              @default(false)
  sickHoursAccrued           Float                @default(0.0)
  ptoHoursAccrued            Float                @default(0.0)
  trialEndsAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  user                       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  venue                      Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  shifts                     ScheduleShift[]
  availability               Availability[]
  pushTokens                 PushToken[]
  timeEntries                TimeEntry[]
  staffRequests              StaffRequest[]
  sentMessages               Message[]
  conversationReads          ConversationRead[]
  notificationEvents         NotificationEvent[]
  notificationReads          NotificationRead[]
  requestedShiftSwaps        ShiftSwap[]          @relation("ShiftSwapRequesterProfile")
  targetShiftSwaps           ShiftSwap[]          @relation("ShiftSwapTargetProfile")
  crmNotes                   CrmNote[]
  crmActivityLogs            CrmActivityLog[]
  tableStateHistory          TableStateHistory[]
  servedTables               TableState[]         @relation("ServerTables")
  assignedLeads              CrmLead[]            @relation("AssignedLeads")
  createdScheduleMemoryNotes ScheduleMemoryNote[] @relation("ScheduleMemoryCreatedBy")
  uploadedDocuments          VenueDocument[]      @relation("DocumentUploader")
  aiUsageEvents              AiUsageEvent[]

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
  @@index([email])
  @@index([tokenIdentifier])
}

model ScheduleShift {
  id             String      @id @default(cuid())
  venueId        String
  profileId      String?
  // Sunday (YYYY-MM-DD) of the concrete calendar week this shift belongs to.
  weekStart      String?
  dayIndex       Int
  startMinutes   Int
  endMinutes     Int
  jobTitle       String
  station        String
  notes          String?
  status         ShiftStatus
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  venue          Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile        Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  requesterSwaps ShiftSwap[] @relation("ShiftSwapRequesterShift")
  targetSwaps    ShiftSwap[] @relation("ShiftSwapTargetShift")
  messages       Message[]

  @@index([venueId])
  @@index([profileId])
  @@index([venueId, weekStart])
  @@index([venueId, profileId, weekStart, dayIndex])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  venueId   String
  startDate DateTime
  endDate   DateTime
  reason    String
  createdBy String
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleTemplate {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  shifts    Json
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleMemoryNote {
  id                 String   @id @default(cuid())
  venueId            String
  weekStart          String
  title              String
  detail             String
  createdByProfileId String?
  createdAt          DateTime @default(now())
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdByProfile   Profile? @relation("ScheduleMemoryCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([venueId, weekStart])
  @@index([venueId, createdAt])
  @@index([createdByProfileId])
}

model Availability {
  id           String   @id @default(cuid())
  venueId      String
  profileId    String
  // Sunday ('YYYY-MM-DD') of the calendar week this availability applies to.
  weekStart    String
  dayIndex     Int
  startMinutes Int
  endMinutes   Int
  available    Boolean
  updatedAt    DateTime @updatedAt
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // One availability row per profile per day per week — the app upserts per
  // day, so this turns retry/race duplicates into a constraint violation.
  @@unique([profileId, weekStart, dayIndex])
  @@index([profileId])
  @@index([venueId])
  @@index([profileId, weekStart])
  @@index([venueId, weekStart])
}

model StaffRequest {
  id                  String        @id @default(cuid())
  venueId             String
  profileId           String
  kind                String
  status              RequestStatus
  title               String
  details             String
  requestedForDate    String?
  requestedShiftId    String?
  requestedRangeStart String?
  requestedRangeEnd   String?
  availability        Json?
  reviewerId          String?
  reviewedAt          DateTime?
  responseNotes       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile             Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([profileId])
  @@index([status])
}

model Conversation {
  id              String             @id @default(cuid())
  venueId         String
  type            String
  name            String?
  memberIds       String[]
  isSystem        Boolean            @default(false)
  lastMessageAt   DateTime?
  lastMessageText String?
  roleName        String?
  shiftDate       String?
  venue           Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages        Message[]
  reads           ConversationRead[]

  @@index([venueId])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  venueId        String
  // Nullable + SetNull so the team's chat history survives a member deleting
  // their account; the UI shows a fallback name for missing senders.
  senderId       String?
  text           String
  createdAt      DateTime       @default(now())
  // Used as an optimistic-concurrency guard for reaction toggles (read-modify
  // -write on the reactions JSON column) so two simultaneous reactions can't
  // silently drop one of them.
  updatedAt      DateTime       @default(now()) @updatedAt
  shiftId        String?
  swapId         String?
  imageUrl       String?
  reactions      Json?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  shift          ScheduleShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  swap           ShiftSwap?     @relation(fields: [swapId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([venueId])
  @@index([shiftId])
  @@index([swapId])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  profileId      String
  venueId        String
  readAt         DateTime     @default(now())
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([conversationId])
  @@index([profileId])
  @@index([venueId])
}

// S3 store for chat photo attachments. Served via an unguessable
// capability URL (GET /v1/chat/images/:id) that redirects to S3 pre-signed URL.
model ChatImage {
  id         String   @id @default(cuid())
  venueId    String
  mimeType   String
  s3Key      String
  uploadedBy String?
  createdAt  DateTime @default(now())
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

// Private venue document library. Object bytes stay in S3; this row carries
// tenant ownership and display metadata used by the mobile app.
model VenueDocument {
  id           String           @id @default(cuid())
  venueId      String
  title        String
  fileName     String
