  contacted
  qualified
  proposal_sent
  negotiating
  won
  lost
  unqualified
  on_hold
}

enum BeoStatus {
  draft
  sent
  reviewed
  confirmed
  amended
  cancelled
}

enum ContractStatus {
  draft
  sent
  viewed
  partially_signed
  fully_signed
  expired
  cancelled
  disputed
}

enum BarStockCategory {
