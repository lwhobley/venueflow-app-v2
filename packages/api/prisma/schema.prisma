  @@index([venueId])
}

// NOTE: a partial unique index exists in SQL only (Prisma cannot express it):
//   TimeEntry_profileId_open_key ON "TimeEntry"("profileId") WHERE "isOpen" = true
// (migration 20260608130000_clock_in_open_unique). If `prisma migrate dev`
// ever generates a DROP for that index, delete that statement before applying.
model TimeEntry {
  id                String    @id @default(cuid())
  venueId           String
  // Nullable + SetNull so wage records survive account deletion (FLSA
  // retention). profileFullName is snapshotted before the profile is removed.
  profileId         String?
  profileFullName   String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  clockInLat        Float
  clockInLng        Float
  clockInAccuracyM  Float
  clockInMocked     Boolean
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutMocked    Boolean?
  isOpen            Boolean
  breaks            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile           Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([venueId, clockInAt])
  @@index([profileId])
  @@index([profileId, isOpen])
  @@index([isOpen])
}

model ShiftSwap {
