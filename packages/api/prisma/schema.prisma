model Reservation {
  id                  String                 @id @default(cuid())
  venueId             String
  guestId             String?
  guestName           String
  guestPhone          String?
  guestEmail          String?
  guestCompany        String?
  partySize           Int
  reservationTime     DateTime
  durationMinutes     Int
  source              ReservationSource
  status              ReservationStatus
  specialRequests     String?
  occasion            String?
  tags                String[]
  isPrivateEvent      Boolean?
  eventName           String?
  eventStatus         String?
  eventSpace          String?
  setupStyle          String?
  menuNotes           String?
  beverageNotes       String?
  billingNotes        String?
  contractStatus      String?
  beoStatus           String?
  estimatedValueCents Int?
  depositDueCents     Int?
  externalId          String?
  // Source-system update time for rejecting delayed webhook events that would
  // otherwise overwrite newer reservation state.
  lastExternalEventAt DateTime?
  toastCheckGuid      String?
  depositStatus       String?
  checkInAt           DateTime?
  seatedAt            DateTime?
  completedAt         DateTime?
  notes               String?
  // Timestamp the reminder email was sent. NULL = not yet reminded; the
  // reminder cron looks for upcoming bookings with this still null.
  reminderSentAt      DateTime?
  // Timestamp the confirmation email was sent (set when status first hits
  // confirmed and guestEmail exists). Prevents duplicate confirmations on
  // status flips.
  confirmationSentAt  DateTime?
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  venue               Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  guest               Guest?                 @relation(fields: [guestId], references: [id], onDelete: SetNull)
  venueEvents         VenueEvent[]
  syncEvents          ReservationSyncEvent[]
  tableAssignments    TableAssignment[]

  @@unique([venueId, source, externalId])
  @@index([venueId, reservationTime])
  @@index([venueId, status])
  @@index([guestId])
  @@index([externalId])
  @@index([venueId, externalId])
  @@index([reminderSentAt, reservationTime])
}

model Waitlist {
