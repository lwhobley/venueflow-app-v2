model Invite {
  id        String   @id @default(cuid())
  venueId   String
  email     String?
  phone     String?
  // The bearer token itself is never stored — only its sha256 hash, so a DB
  // dump/backup leak can't yield usable signup links for pending invites
  // (mirrors Session.tokenHash). The plaintext lives only in memory for the
  // request that mints/rotates it, long enough to embed in the outgoing
  // email/deep-link.
  tokenHash String   @unique
  // Short, human-typeable join code (e.g. "VW-7K2Q9"); employees enter this to
  // join a team. The long token (hashed above) backs the venuewrangler://join
  // deep link.
  code      String?  @unique
  role      Role
  jobTitle  String
  createdBy String
  usedBy    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // NOTE: a partial SQL-only index (Invite_phone_idx) exists on top of this
  // schema. Prisma can't represent partial indexes; if `prisma migrate dev`
  // ever generates a DROP for it, delete that statement before applying.
  @@index([email])
  @@index([venueId])
}

model WorkplaceJoinRequest {
  id           String                      @id @default(cuid())
  venueId      String
  userId       String
  status       WorkplaceJoinRequestStatus  @default(pending)
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  venue        Venue                       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User                        @relation("WorkplaceJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?                       @relation("WorkplaceJoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  events       WorkplaceJoinRequestEvent[]

  // NOTE: a partial SQL-only unique index
  // (WorkplaceJoinRequest_one_pending_per_user_venue_idx, WHERE status =
  // 'pending') exists on top of this schema. Prisma can't represent partial
  // indexes; if `prisma migrate dev` ever generates a DROP for it, delete
  // that statement before applying — dropping it re-opens duplicate pending
  // request races.
  @@index([venueId])
  @@index([userId])
  @@index([status])
  @@index([venueId, status])
  @@index([decidedById])
}

model WorkplaceJoinRequestEvent {
  id        String               @id @default(cuid())
  requestId String
  actorId   String?
  eventType String
  payload   Json?
  createdAt DateTime             @default(now())
  request   WorkplaceJoinRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId])
}

